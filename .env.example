# ─── BugBuddy Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to source control

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password_here

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password_here

# ─── MinIO (local object storage) ────────────────────────────────────────────
MINIO_ACCESS_KEY=change_me_minio_access_key
MINIO_SECRET_KEY=change_me_minio_secret_key_min_8_chars

# ─── Google OAuth 2.0 ────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Backend ─────────────────────────────────────────────────────────────────
# 64+ character random string: openssl rand -hex 32
SESSION_SECRET=change_me_64_char_hex_string_here

# AES-256-GCM key for encrypting attachments at rest (32-byte hex)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=change_me_32_byte_hex_key_for_aes256

# Allowed frontend origin (no trailing slash)
CORS_ORIGIN=https://your-domain.com

# ─── Jira Integration (optional — leave blank to disable) ───────────────────
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
