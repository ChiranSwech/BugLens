{
  "name": "buglens",
  "private": true,
  "version": "0.1.0",
  "description": "Enterprise bug capture & reporting platform",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:extension": "pnpm --filter @buglens/extension build",
    "pack:extension": "pnpm run build:extension && powershell -Command \"Compress-Archive -Path 'packages/extension/dist/*' -DestinationPath 'buglens-v2-extension.zip' -Force; Copy-Item 'buglens-v2-extension.zip' -Destination 'buglens-extension-v2.0.0.zip' -Force; Copy-Item 'buglens-v2-extension.zip' -Destination 'buglens-extension.zip' -Force\"",
    "pack:crx": "pnpm run build:extension && npx -y crx3 -o buglens-extension.crx packages/extension/dist",
    "build:backend": "pnpm --filter @buglens/backend build",
    "build:shared": "pnpm --filter @buglens/shared build",
    "build:web": "pnpm --filter @buglens/web build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
